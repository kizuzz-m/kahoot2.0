# ─────────────────────────────────────────────────────────────
# Quizwerk – Umgebungsvariablen
# Kopiere diese Datei nach .env.local und passe sie an.
# Ohne Supabase-Werte läuft alles lokal (JSON-Datei + WebSocket-Relay).
# ─────────────────────────────────────────────────────────────

# Supabase (optional) – Projekt-URL und anon/public Key (Dashboard → Project Settings → API)
# Diese Werte werden NICHT in den Build eingebaut, sondern zur Laufzeit gelesen
# (Server direkt, Browser über /api/config). Auf Cloudflare als Secrets setzen.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Empfohlen: Service-Role-Key, wird NUR serverseitig in den API-Routen verwendet
SUPABASE_SERVICE_ROLE_KEY=

# Passwort für den Admin-Bereich (/admin). Ohne Wert ist /admin für alle offen.
# Online unbedingt setzen (bei Cloudflare als Secret).
ADMIN_PASSWORD=

# Lokaler Relay (nur ohne Supabase relevant)
# Standard: gleicher Hostname wie die Webseite, Port 3001
NEXT_PUBLIC_RELAY_PORT=3001
# NEXT_PUBLIC_RELAY_URL=ws://192.168.1.20:3001
# RELAY_PORT=3001

# Feste Basis-URL für den QR-Code (z. B. bei Deployment oder Tunnel), zur Laufzeit gelesen
# PUBLIC_BASE_URL=http://192.168.1.20:3000

# Zusätzliche Hostnamen für den Dev-Server (kommagetrennt), z. B. für Tunnel
# ALLOWED_DEV_ORIGINS=mein-tunnel.example.com

# Speicherort der lokalen JSON-Datenbank (Standard: ./.data)
# QUIZWERK_DATA_DIR=./.data
